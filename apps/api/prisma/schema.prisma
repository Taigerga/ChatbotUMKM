generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  tokenVersion Int            @default(0)
  createdAt    DateTime       @default(now())
  memberships  TenantMember[]
}

model Tenant {
  id        String         @id @default(cuid())
  name      String
  currency  String         @default("IDR")
  timezone  String         @default("Asia/Jakarta")
  isDemo    Boolean        @default(false)
  createdAt DateTime       @default(now())
  members   TenantMember[]
}

model TenantMember {
  id       String @id @default(cuid())
  userId   String
  tenantId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model Customer {
  id          String @id @default(cuid())
  tenantId    String
  externalRef String
  name        String
  phone       String?
  email       String?
  createdAt   DateTime @default(now())

  @@unique([tenantId, externalRef])
  @@index([tenantId])
}

model Product {
  id        String   @id @default(cuid())
  tenantId  String
  sku       String
  name      String
  category  String?
  price     Decimal  @db.Decimal(14, 2)
  cost      Decimal? @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model Sale {
  id             String     @id @default(cuid())
  tenantId       String
  customerId     String?
  occurredAt     DateTime   @db.DateTime(3)
  notes          String?
  subtotal       Decimal    @db.Decimal(14, 2)
  discount       Decimal    @default(0) @db.Decimal(14, 2)
  tax            Decimal    @default(0) @db.Decimal(14, 2)
  total          Decimal    @db.Decimal(14, 2)
  source         String     @default("manual")
  idempotencyKey String?
  createdAt      DateTime   @default(now())
  items          SaleItem[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, occurredAt])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String?
  description String
  qty         Int
  unitPrice   Decimal @db.Decimal(14, 2)
  lineTotal   Decimal @db.Decimal(14, 2)
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model ChatConversation {
  id        String        @id @default(cuid())
  tenantId  String
  userId    String
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
  messages  ChatMessage[]

  @@index([tenantId, createdAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           String
  content        String           @db.LongText
  toolName       String?
  toolResult     Json?
  actionId       String?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model PendingAction {
  id             String    @id @default(cuid())
  tenantId       String
  conversationId String
  tool           String
  payload        Json
  preview        Json
  status         String    @default("proposed")
  expiresAt      DateTime
  executedAt     DateTime?
  result         Json?
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())

  @@index([tenantId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  action    String
  entity    String
  entityId  String
  summary   Json
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model MlModel {
  id           String    @id @default(cuid())
  tenantId     String?
  modelName    String
  version      String
  status       String
  metrics      Json?
  dataRange    String?
  trainedAt    DateTime?
  artifactPath String

  @@unique([tenantId, modelName, version])
}

model MlJob {
  id          String   @id @default(cuid())
  tenantId    String?
  modelName   String
  type        String
  status      String   @default("queued")
  progress    Int      @default(0)
  remoteJobId String?
  error       String?
  result      Json?
  createdAt   DateTime @default(now())

  @@index([tenantId, status])
}

model ImportJob {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  filename   String
  entity     String
  status     String   @default("preview")
  mapping    Json?
  rows       Json?
  rowCount   Int      @default(0)
  validCount Int      @default(0)
  errorCount Int      @default(0)
  report     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([tenantId, createdAt])
}
